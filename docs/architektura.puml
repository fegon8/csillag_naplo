@startuml
skinparam classAttributeIconSize 0

package "hu.astrolog.modell" {
    abstract class Egitest {
        - nev: String
        - magnitudo: double
        + {abstract} getTipus(): String
        + {abstract} alapPont(): double
    }
    class Bolygo {
        - fazisSzazalek: int
        + getTipus(): String
        + alapPont(): double
    }
    class MelyegObjektum {
        - kategoria: String
        + getTipus(): String
        + alapPont(): double
    }
    class Tavcso {
        - nev: String
        - atmeroMm: int
    }
    class EszlelesiAlkalom {
        - datum: LocalDate
        - helyszin: String
        - bortle: int
        - tavcso: Tavcso
        - egitestek: List<Egitest>
    }
}

package "hu.astrolog.szolgaltatas" {
    interface PontozasiStrategia {
        + szamitPont(egitest: Egitest, bortle: int): double
    }
    class AlapPontozas
    class MelyegPontozas
    class NaploSzolgaltatas {
        - alkalmak: List<EszlelesiAlkalom>
        - feloldottEgitestek: Map<String, LocalDate>
        - aktivAlkalom: EszlelesiAlkalom
        - defaultTavcso: Tavcso
        - strategia: PontozasiStrategia
    }
}

Egitest <|-- Bolygo
Egitest <|-- MelyegObjektum
EszlelesiAlkalom "1" *-- "0..*" Egitest
EszlelesiAlkalom "0..*" --> "1" Tavcso
PontozasiStrategia <|.. AlapPontozas
PontozasiStrategia <|.. MelyegPontozas
NaploSzolgaltatas --> PontozasiStrategia
NaploSzolgaltatas "1" o-- "0..*" EszlelesiAlkalom
@enduml